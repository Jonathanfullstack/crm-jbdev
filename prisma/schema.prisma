generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  SELLER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum LeadKind {
  LEAD
  CLIENT
}

enum StageKind {
  OPEN
  WON
  LOST
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  LEAD_CREATED
  STAGE_CHANGED
  OWNER_CHANGED
  VALUE_CHANGED
  NOTE
  TASK
  FOLLOW_UP
  CALL
  WHATSAPP
  EMAIL
  MEETING
  MESSAGE
  PROPOSAL
  CONVERTED
}

enum FollowUpType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  RETURN
  TASK
  OTHER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum ProposalStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
}

enum NotificationType {
  FOLLOW_UP_OVERDUE
  TASK_DUE
  NEW_LEAD
  LEAD_ASSIGNED
  PROPOSAL_WAITING
}

enum WorkspaceTheme {
  LIGHT
  DARK
  SYSTEM
}

model Workspace {
  id                   String         @id @default(cuid())
  name                 String         @default("CRM")
  slug                 String?        @unique
  logoUrl              String?
  faviconUrl           String?
  phone                String?
  email                String?
  website              String?
  primaryColor         String         @default("#475569")
  secondaryColor       String?
  theme                WorkspaceTheme @default(SYSTEM)
  showDeveloperCredit  Boolean        @default(false)
  onboardingDone       Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  users         User[]
  pipelines     Pipeline[]
  stages        PipelineStage[]
  sources       Source[]
  lostReasons   LostReason[]
  tags          Tag[]
  companies     Company[]
  leads         Lead[]
  opportunities Opportunity[]
  products      Product[]
  proposals     Proposal[]
  tasks         Task[]
  followUps     FollowUp[]
  notes         Note[]
  activities    Activity[]
  notifications Notification[]
  apiKeys       ApiKey[]
}

model User {
  id           String     @id @default(cuid())
  workspaceId  String
  name         String
  email        String
  passwordHash String
  role         UserRole   @default(SELLER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  workspace           Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sessions            Session[]
  ownedLeads          Lead[]        @relation("LeadOwner")
  ownedOpportunities  Opportunity[] @relation("OpportunityOwner")
  tasks               Task[]
  followUps           FollowUp[]
  notes               Note[]
  activities          Activity[]
  notifications       Notification[]
  createdApiKeys      ApiKey[]

  @@unique([workspaceId, email])
  @@index([workspaceId, role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
}

model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  isDefault   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  stages    PipelineStage[]

  @@index([workspaceId])
}

model PipelineStage {
  id          String    @id @default(cuid())
  workspaceId String
  pipelineId  String
  name        String
  color       String    @default("#64748B")
  position    Int
  isHidden    Boolean   @default(false)
  kind        StageKind @default(OPEN)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pipeline      Pipeline      @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads         Lead[]
  opportunities Opportunity[]

  @@index([workspaceId, pipelineId, position])
}

model Source {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@unique([workspaceId, slug])
}

model LostReason {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads         Lead[]
  opportunities Opportunity[]

  @@index([workspaceId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#6366F1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     LeadTag[]

  @@unique([workspaceId, name])
}

model Company {
  id          String   @id @default(cuid())
  workspaceId String
  legalName   String
  tradeName   String?
  document    String?
  phone       String?
  email       String?
  website     String?
  segment     String?
  city        String?
  state       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@index([workspaceId])
}

model Lead {
  id             String    @id @default(cuid())
  workspaceId    String
  firstName      String
  lastName       String?
  companyName    String?
  companyId      String?
  phone          String?
  whatsapp       String?
  email          String?
  jobTitle       String?
  city           String?
  state          String?
  sourceId       String?
  stageId        String
  ownerId        String?
  estimatedValue Decimal?  @db.Decimal(12, 2)
  probability    Int?
  interest       String?
  notes          String?
  kind           LeadKind  @default(LEAD)
  lastContactAt  DateTime?
  nextFollowUpAt DateTime?
  convertedAt    DateTime?
  lostReasonId   String?
  lostNotes      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source        Source?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  stage         PipelineStage @relation(fields: [stageId], references: [id])
  owner         User?         @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lostReason    LostReason?   @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  tags          LeadTag[]
  opportunities Opportunity[]
  proposals     Proposal[]
  tasks         Task[]
  followUps     FollowUp[]
  notesList     Note[]
  activities    Activity[]

  @@index([workspaceId, stageId])
  @@index([workspaceId, ownerId])
  @@index([workspaceId, kind])
  @@index([workspaceId, nextFollowUpAt])
}

model LeadTag {
  leadId    String
  tagId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([leadId, tagId])
}

model Product {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  category    String?
  price       Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunities Opportunity[]

  @@index([workspaceId])
}

model Opportunity {
  id            String            @id @default(cuid())
  workspaceId   String
  title         String
  leadId        String
  productId     String?
  value         Decimal?          @db.Decimal(12, 2)
  stageId       String
  probability   Int?
  ownerId       String?
  expectedClose DateTime?
  status        OpportunityStatus @default(OPEN)
  lostReasonId  String?
  lostNotes     String?
  closedAt      DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace  Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product    Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  stage      PipelineStage  @relation(fields: [stageId], references: [id])
  owner      User?          @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  lostReason LostReason?    @relation(fields: [lostReasonId], references: [id], onDelete: SetNull)
  proposals  Proposal[]
  activities Activity[]

  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
}

model Proposal {
  id            String         @id @default(cuid())
  workspaceId   String
  opportunityId String?
  leadId        String
  title         String         @default("Proposta")
  value         Decimal        @db.Decimal(12, 2)
  description   String?
  items         Json?
  sentAt        DateTime?
  validUntil    DateTime?
  status        ProposalStatus @default(DRAFT)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId, status])
}

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  title       String
  description String?
  ownerId     String
  leadId      String?
  dueAt       DateTime?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  lead      Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId, ownerId, status])
  @@index([workspaceId, dueAt])
}

model FollowUp {
  id          String       @id @default(cuid())
  workspaceId String
  leadId      String
  ownerId     String
  type        FollowUpType
  description String?
  dueAt       DateTime
  priority    Priority     @default(MEDIUM)
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId, ownerId, dueAt])
  @@index([workspaceId, completedAt])
}

model Note {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  authorId    String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadId])
}

model Activity {
  id            String       @id @default(cuid())
  workspaceId   String
  leadId        String?
  opportunityId String?
  actorId       String?
  type          ActivityType
  title         String
  description   String?
  metadata      Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  opportunity Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  actor       User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, leadId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  workspaceId String
  userId      String
  type        NotificationType
  title       String
  body        String?
  link        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, readAt])
}
